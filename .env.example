# Gokul Shree School App - Environment Configuration Template
# Copy this file to .env and fill in your credentials
# DO NOT commit .env to version control!

# ===========================================
# SUPABASE CONFIGURATION
# ===========================================
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key

# ===========================================
# BACKEND API CONFIGURATION
# ===========================================
API_BASE_URL=http://10.0.2.2:3000/api
API_TIMEOUT_SECONDS=30

# ===========================================
# APP CONFIGURATION
# ===========================================
APP_NAME=Gokul Shree School
APP_VERSION=1.0.0
DEBUG_MODE=false

# ===========================================
# WEBSITE URLS
# ===========================================
WEBSITE_BASE_URL=https://gokulshreeschool.com
VERIFY_BASE_URL=https://gokulshreeschool.com/verify

# ===========================================
# BRANDING (white-label — override per institute)
# ===========================================
APP_SHORT_NAME=Gokulshree
LEGAL_NAME=Gokulshree School Of Management And Technology Private Limited
SUPPORT_EMAIL=info@gokulshreeschool.com
INSTITUTE_ADDRESS_LINE1=Gokul Shree School of Management
INSTITUTE_ADDRESS_LINE2=Varanasi, Uttar Pradesh, India
LOGO_ASSET_PATH=assets/images/school_logo.png
# Changing AUTH_EMAIL_DOMAIN on an existing deployment invalidates already-
# created synthetic accounts for users who logged in via phone/reg-no.
AUTH_EMAIL_DOMAIN=gokulshree.local
